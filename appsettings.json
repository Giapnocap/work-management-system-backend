{
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=WorkManagementDB;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False;"
  },
  "Jwt": {
    "Issuer": "WorkManagementSystem",
    "Audience": "WorkManagementFrontend",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "ReverseProxy": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "UploadCleanup": {
    "Enabled": true,
    "MinimumAgeHours": 24,
    "IntervalHours": 24
  },
  "Workload": {
    "DefaultWeeklyCapacityHours": 40,
    "BusyThresholdPercent": 70,
    "OverloadedThresholdPercent": 90,
    "MaxRangeDays": 366
  },
  "RecurringTasks": {
    "Enabled": true,
    "PollingIntervalSeconds": 60,
    "MaxTemplatesPerBatch": 50,
    "MaxCatchUpOccurrencesPerTemplate": 10
  },
  "DeadlineReminders": {
    "Enabled": true,
    "PollingIntervalSeconds": 60,
    "MaxTasksPerBatch": 100,
    "MaxDeliveriesPerBatch": 200,
    "MaxRetryCount": 3
  },
  "DemoSeed": {
    "Enabled": false,
    "ApplyMigrations": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
